{
  "name": "vinuni-solutions-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "docker compose --profile app up --build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",

    "app:build": "docker compose --profile app build app",
    "app:up": "docker compose --profile app up -d --build app",
    "app:stop": "docker compose --profile app stop app",
    "app:start": "docker compose --profile app start app",
    "app:restart": "docker compose --profile app restart app",
    "app:down": "docker compose --profile app down",
    "app:logs": "docker compose --profile app logs -f app",
    "app:install": "docker compose exec app pnpm install --frozen-lockfile",
    "app:migrate": "docker compose exec app pnpm db:migrate",
    "app:seed": "docker compose exec -e ALLOW_DB_SEED=true app pnpm db:seed",

    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "motion": "^13.1.1",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "^5"
  }
}
