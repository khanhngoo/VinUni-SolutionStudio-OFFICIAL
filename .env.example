# Host form — used by `pnpm dev` and every host-run script (db:migrate, db:seed, ...).
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME

# For managed production PostgreSQL, set DATABASE_URL to the pooled runtime
# connection and use a direct database connection for reviewed migrations.
# MIGRATION_DATABASE_URL=postgresql://USERNAME:PASSWORD@DIRECT_HOST:5432/DATABASE_NAME?sslmode=require

# Container form — used automatically by the `app` Compose service
# (`docker compose --profile app up`), which reaches PostgreSQL over the
# Compose network at the `db` service hostname instead of `localhost`.
# This value is set directly in docker-compose.yml and does not need to be
# duplicated in your local .env file:
#   DATABASE_URL=postgresql://USERNAME:PASSWORD@db:5432/DATABASE_NAME
AUTH_SECRET=replace-with-a-long-random-secret

# Explicitly enable database-backed email/password accounts for a private
# internal demo. This path has no email verification or password recovery yet.
AUTH_SELF_SERVICE_ENABLED=false
# Local/internal QA only. Requires AUTH_SELF_SERVICE_ENABLED=true and NODE_ENV != production.
AUTH_DEV_PERSONAS_ENABLED=false

# Optional public-site demo login. Use a unique random secret of at least 24
# characters. The demo maps only to the active seeded Jordan student record;
# leave AUTH_SELF_SERVICE_ENABLED=false for a public demo-only launch.
# AUTH_DEMO_PASSWORD=replace-with-a-unique-random-secret-at-least-24-characters

AUTH_MICROSOFT_ENTRA_ID_ID=vinuni-entra-application-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=vinuni-entra-application-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/VINUNI_TENANT_ID/v2.0

# Optional Google sign-in for existing active Studio users. Register the
# https://YOUR_DOMAIN/api/auth/callback/google redirect URI in Google Cloud.
# AUTH_GOOGLE_ID=google-oauth-client-id
# AUTH_GOOGLE_SECRET=google-oauth-client-secret
